# El token del registry vive crudo (sin comillas ni export) en
# .kamal/registry-password, gitignored. Sin nada que parsear:
# basta `kamal deploy`. Para rotarlo: pegar el token nuevo ahí.
KAMAL_REGISTRY_PASSWORD=$(cat .kamal/registry-password)

# LA FORJA — la API key de Gemini se toma del .env de generate_sprites (fuera
# del repo); el código de creación y la clave de moderación viven en archivos
# gitignored. Estas líneas son solo referencias, sin secretos: seguras aunque
# .kamal/secrets se versione.
GOOGLE_API_KEY=$(grep '^GOOGLE_API_KEY=' ../generate_sprites/.env | cut -d= -f2-)
FORJA_TOKENS=$(cat .kamal/forja-tokens)
FORJA_ADMIN_KEY=$(cat .kamal/forja-admin-key)
